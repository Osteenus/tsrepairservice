# Copy to .env and fill in. Never commit .env.
PORT=3001
PUBLIC_URL=https://voice.tsrepairservice.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+18053348375
# Technician's mobile for transfers, E.164 (+1...)
OWNER_PHONE=
# Call recording (stored in Twilio): keeps the caller's agreement to the service call fee.
RECORD_CALLS=true

# Voice (Google Chirp3-HD). Other female voices: Kore, Leda, Zephyr.
# TTS_VOICE=en-US-Chirp3-HD-Aoede
# SAY_VOICE=Google.en-US-Chirp3-HD-Aoede

# Same value as VOICE_API_KEY in the Laravel .env
VOICE_API_KEY=
LARAVEL_URL=https://tsrepairservice.com

CALL_LIMIT_SECONDS=300
CALLS_PER_HOUR=3
