[Unit]
Description=TS Repair Service Inertia SSR
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/tsrepairservice
ExecStart=/home/osteen/.nvm/versions/node/v24.11.1/bin/node /var/www/html/tsrepairservice/bootstrap/ssr/ssr.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
